{
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  },
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/run-scheduled-agents",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/allocate-credits",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/refresh-pricing",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/calculate-engagement",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/nudge-inactive",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/morning-digest",
      "schedule": "0 12 * * *"
    }
  ]
}
